{
  "name": "magpie-retry",
  "version": "0.1.0",
  "description": "自动重试（网关熔断）：上游连不上时数着失败快速回 429，引导 agent 按自己的退避节奏重试，恢复后自动放行——对话不被网络抖动弄死",
  "type": "module",
  "files": [
    "retry.middleware.js",
    "lib",
    "tests",
    "ui",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "magpie",
    "magpie-plugin",
    "middleware",
    "gateway",
    "retry",
    "circuit-breaker",
    "重试",
    "熔断"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CallMeKingsley97/magpie-retry"
  },
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\""
  },
  "magpie": {
    "middleware": "./retry.middleware.js",
    "panels": [
      {
        "slot": "settings",
        "title": "自动重试",
        "file": "ui/panel.html"
      }
    ],
    "options": {
      "enabled": true,
      "threshold": 3,
      "baseSeconds": 20,
      "maxSeconds": 120
    },
    "permissions": []
  }
}
